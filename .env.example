# Runtime server configuration. Use a full generations endpoint, not just a base URL.
# Restart pnpm dev / pnpm start after changing this file. No rebuild required.
IMAGE_API_ENDPOINT=https://www.kurumiai.net/v1/images/generations
# Register this exact callback in new-api Settings > Integrations > Client connect:
# https://studio.kurumiai.net/api/auth/callback
NEW_API_BASE_URL=https://www.kurumiai.net
IMAGE_STUDIO_ORIGIN=https://studio.kurumiai.net
# Local development only (both URLs must use a loopback host):
# IMAGE_STUDIO_ORIGIN=http://localhost:5173
# IMAGE_STUDIO_ALLOW_LOOPBACK_HTTP=1
# Optional: by default replaces /generations with /edits.
# IMAGE_EDIT_ENDPOINT=https://www.kurumiai.net/v1/images/edits
# SITE_NAME=CodexProxy
# SITE_LOGO=https://www.kurumiai.net/logo.png
# HOST=0.0.0.0
# PORT=3000
# IMAGE_DATA_DIR=./data
